# Copy to `.env` (gitignored) and fill in. Loaded by python-dotenv locally;
# in a Databricks job these are supplied as job/task parameters instead.

# --- Market-data vendor (TBD) ---
VENDOR_API_BASE_URL=
VENDOR_API_KEY=

# --- Landing / Bronze ---
LANDING_VOLUME_PATH=/Volumes/ygz_massive_stock_dev/landing/raw_massive_data
LANDING_SCHEMA=landing
BRONZE_SCHEMA=bronze

# --- Databricks (local dev: dbt profiles.yml + venv_dbc/Databricks Connect) ---
# DATABRICKS_CONFIG_PROFILE names a section in ~/.databrickscfg; when set,
# .venv_dbc's DatabricksSession picks it up automatically (via dbc_connection_check.py
# calling load_dotenv()). dbt's profiles.yml doesn't read profiles - it uses
# the HOST/HTTP_PATH/TOKEN values below directly, so keep them matching
# whichever ~/.databrickscfg profile you're pointing at.
DATABRICKS_CONFIG_PROFILE=DBT
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# --- dbt ---
DBT_CATALOG=ygz_massive_stock_dev
DBT_SCHEMA=silver
