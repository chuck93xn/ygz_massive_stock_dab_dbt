# Copy to `.env` (gitignored) and fill in. Loaded by python-dotenv locally;
# in a Databricks job these are supplied as job/task parameters instead.

# --- Market-data vendor (TBD) ---
VENDOR_API_BASE_URL=
VENDOR_API_KEY=

# --- Landing / Bronze ---
LANDING_VOLUME_PATH=/Volumes/dev_catalog/landing/raw
LANDING_SCHEMA=landing
BRONZE_SCHEMA=bronze

# --- Databricks (local dev: dbt profiles.yml + venv_dbc/Databricks Connect) ---
# DATABRICKS_HOST/TOKEN are shared by both; HTTP_PATH is only needed for
# dbt's classic-cluster/warehouse connection, not for serverless Connect.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# --- dbt ---
DBT_CATALOG=dev_catalog
DBT_SCHEMA=silver
